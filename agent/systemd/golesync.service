[Unit]
Description=GoleSync agent (phone <-> laptop)
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
# Installed by scripts/install.sh; %h = your home directory.
ExecStart=%h/.local/share/golesync/venv/bin/golesync serve --no-qr
Restart=on-failure
RestartSec=3
# Remote control needs your X11 session's DISPLAY/XAUTHORITY. They are imported by
# `systemctl --user import-environment DISPLAY XAUTHORITY` (see install.sh / README).
PassEnvironment=DISPLAY XAUTHORITY

# Launcher buttons start GUI apps (Brave, VS Code, Slack, snaps...). Those need the normal user
# environment, so this unit is deliberately NOT sandboxed with NoNewPrivileges/PrivateTmp (which
# break snap and Chromium/Electron sandboxes). The command allow-list is the security boundary.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin:/var/lib/flatpak/exports/bin:%h/.local/share/flatpak/exports/bin
# Apps started from the phone must survive an agent restart.
KillMode=process

[Install]
WantedBy=graphical-session.target
